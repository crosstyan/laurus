# laurus debug fragment — apply on top of:
#   vendor/trinket-perf_defconfig vendor/xiaomi-trinket.config vendor/laurel_sprout.config
# Only 3 options are =m (IR_MSM_GENI, RMNET_PERF, RMNET_SHS), so ABI changes are fine
# as long as the 3 .ko from this build replace the ones in /vendor/lib/modules.

# Identify the build in uname -r
CONFIG_LOCALVERSION="-perf-laurusdbg"

# Module signing off: unsigned / foreign-signed modules load
# CONFIG_MODULE_SIG is not set

# UART console on TP4711/TP4712 (qup_uart@4a90000, enabled in the DTB);
# needs console=ttyMSM0,115200n8 earlycon=msm_geni_serial,0x4a90000 (repack --uart)
CONFIG_SERIAL_MSM_GENI_CONSOLE=y

# Bigger log buffer so early boot is not overwritten (2 MiB)
CONFIG_LOG_BUF_SHIFT=21

# pstore: keep console + pmsg (already on); also capture panics/oops in dmesg-ramoops
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y

# Lockup / hang detection (report only; panic via cmdline softlockup_panic=1 if wanted)
CONFIG_LOCKUP_DETECTOR=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=120
CONFIG_WQ_WATCHDOG=y

# debugfs, dynamic debug (dyndbg="file foo.c +p" on the cmdline)
CONFIG_DEBUG_FS=y
CONFIG_DYNAMIC_DEBUG=y

# Tracing: function tracer, syscalls, block, kprobes/uprobes, BPF
CONFIG_FUNCTION_TRACER=y
# (FUNCTION_GRAPH_TRACER is unavailable: arm64 SHADOW_CALL_STACK excludes it)
CONFIG_DYNAMIC_FTRACE=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_BLK_DEV_IO_TRACE=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBE_EVENTS=y
CONFIG_BPF_EVENTS=y

# Suspend/resume debugging
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y

# SLUB debugging compiled in, off by default (enable with slub_debug=FZPU)
CONFIG_SLUB_DEBUG=y

# Faster rebuilds and readable backtraces: no LTO
# CONFIG_LTO_CLANG is not set
CONFIG_LTO_NONE=y
