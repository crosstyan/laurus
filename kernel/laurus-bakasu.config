# laurus BakaSU fragment: manual hooks (fs/exec.c, fs/open.c, fs/stat.c, kernel/reboot.c),
# setuid/init.rc/input auto-hooked via LSM / input handler. KALLSYMS_ALL=y already in LOS config.
CONFIG_LOCALVERSION="-perf-bakasu"
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y
CONFIG_KSU_MANUAL_HOOK_AUTO_SETUID_HOOK=y
CONFIG_KSU_MANUAL_HOOK_AUTO_INITRC_HOOK=y
CONFIG_KSU_MANUAL_HOOK_AUTO_INPUT_HOOK=y
